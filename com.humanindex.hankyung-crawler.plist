<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.humanindex.hankyung-crawler</string>

    <key>ProgramArguments</key>
    <array>
        <string>/opt/anaconda3/bin/python3</string>
        <string>/Users/suyeongpark/Dev/Suyeongpark/human-index/scripts/crawl_hankyung.py</string>
    </array>

    <key>WorkingDirectory</key>
    <string>/Users/suyeongpark/Dev/Suyeongpark/human-index</string>

    <!-- 매일 오후 6시 30분 실행 (장 마감 후, 리포트 업로드 완료 시점) -->
    <key>StartCalendarInterval</key>
    <dict>
        <key>Hour</key>
        <integer>18</integer>
        <key>Minute</key>
        <integer>30</integer>
    </dict>

    <!-- 로그 출력 -->
    <key>StandardOutPath</key>
    <string>/Users/suyeongpark/Dev/Suyeongpark/human-index/logs/hankyung_stdout.log</string>
    <key>StandardErrorPath</key>
    <string>/Users/suyeongpark/Dev/Suyeongpark/human-index/logs/hankyung_stderr.log</string>

    <!-- 실패 시 재시도 하지 않음 -->
    <key>StartInterval</key>
    <integer>0</integer>
</dict>
</plist>
