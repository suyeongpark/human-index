<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.humanindex.daily-worker</string>

    <key>ProgramArguments</key>
    <array>
        <string>/opt/anaconda3/bin/python3</string>
        <string>/Users/suyeongpark/Dev/Suyeongpark/human-index/scripts/daily_worker.py</string>
    </array>

    <key>WorkingDirectory</key>
    <string>/Users/suyeongpark/Dev/Suyeongpark/human-index</string>

    <!-- 매일 오전 9시 실행 (장 시작 전) -->
    <key>StartCalendarInterval</key>
    <dict>
        <key>Hour</key>
        <integer>9</integer>
        <key>Minute</key>
        <integer>0</integer>
    </dict>

    <!-- 로그 출력 -->
    <key>StandardOutPath</key>
    <string>/Users/suyeongpark/Dev/Suyeongpark/human-index/logs/launchd_stdout.log</string>
    <key>StandardErrorPath</key>
    <string>/Users/suyeongpark/Dev/Suyeongpark/human-index/logs/launchd_stderr.log</string>

    <!-- 실패 시 재시도 하지 않음 -->
    <key>StartInterval</key>
    <integer>0</integer>
</dict>
</plist>
